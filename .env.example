# Copy to .env and fill in. .env is in .gitignore and never goes to GitHub.

# Database: Supabase "Session pooler" connection string (leave empty for a local SQLite file)
DATABASE_URL=

# Server-side Gemini key: CLI scripts, weekly refresh job, and admin actions
GEMINI_API_KEY=

# Google sign-in (Google Cloud Console -> Google Auth Platform -> Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who can open the Admin page (comma separated Google emails)
ADMIN_EMAILS=

# ENCRYPTION_KEY and COOKIE_SECRET are generated by: python scripts/make_secrets.py
